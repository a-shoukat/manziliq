# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Credentials
# Get these from your Supabase Project Settings -> API (Project URL & anon/public API Key)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Email Notification Service (Google SMTP / Gmail / Custom SMTP)
# For Google SMTP (Gmail / Google Workspace):
# 1. SMTP_USER: Your full Gmail address (e.g. yourname@gmail.com)
# 2. SMTP_PASS: 16-character Google App Password (NOT your normal account password).
#    Generate it at: https://myaccount.google.com/apppasswords
# 3. SMTP_HOST: smtp.gmail.com (default)
# 4. SMTP_PORT: 465 (SSL, recommended) or 587 (TLS)
# 5. SMTP_SECURE: true (for port 465)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-google-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME="MANZILIQ Smart Housing"

# SMS Gateway Configuration (Pakistan Telco Gateway / Twilio)
SMS_GATEWAY_API_KEY=your-sms-api-key
SMS_GATEWAY_SENDER_ID=MANZILIQ
SMS_GATEWAY_URL=https://api.sms-gateway.pk/v2/send

# Firebase Cloud Messaging (FCM) Configuration
FCM_SERVER_KEY=your-firebase-server-or-v1-key
FIREBASE_PROJECT_ID=manziliq-housing

# OpenAI API Key (Optional for Whisper Speech-to-Text & Fallback Extraction)
OPENAI_API_KEY=your-openai-api-key

# Python Flask Voice Microservice (Optional external microservice endpoint)
FLASK_VOICE_SERVICE_URL=http://localhost:5000/api/voice/transcribe-and-extract

# Google Maps Platform (Maps JavaScript API + Places API)
# Store your client-side Google Maps API key here
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

