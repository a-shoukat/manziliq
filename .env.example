# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Credentials
# Get these from your Supabase Project Settings -> API (Project URL & anon/public API Key)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Email Notification Service (SMTP / Provider)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@mg.manziliq.pk
SMTP_PASS=your-smtp-password
EMAIL_FROM=notifications@manziliq.pk
EMAIL_FROM_NAME="MANZILIQ Smart Housing"

# SMS Gateway Configuration (Pakistan Telco Gateway / Twilio)
SMS_GATEWAY_API_KEY=your-sms-api-key
SMS_GATEWAY_SENDER_ID=MANZILIQ
SMS_GATEWAY_URL=https://api.sms-gateway.pk/v2/send

# Firebase Cloud Messaging (FCM) Configuration
FCM_SERVER_KEY=your-firebase-server-or-v1-key
FIREBASE_PROJECT_ID=manziliq-housing

# OpenAI API Key (Optional for Whisper Speech-to-Text & Fallback Extraction)
OPENAI_API_KEY=your-openai-api-key

# Python Flask Voice Microservice (Optional external microservice endpoint)
FLASK_VOICE_SERVICE_URL=http://localhost:5000/api/voice/transcribe-and-extract
